# ==========================================
# Application Environment Variables Template
# ==========================================

# Secret Key (Generate a random unique string in production)
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=*

# Production Database (Set in Vercel / Cloud Dashboard)
# DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require

# Email SMTP Settings (For Password Resets)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# OTP & Security
ENABLE_OTP_VERIFICATION=False
OTP_DEV_MODE=False
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
